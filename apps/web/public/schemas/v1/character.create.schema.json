{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:animation-studio:contracts:v1:character.create",
  "additionalProperties": false,
  "properties": {
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    }
  },
  "required": [
    "name"
  ],
  "title": "CharacterCreate",
  "type": "object"
}
