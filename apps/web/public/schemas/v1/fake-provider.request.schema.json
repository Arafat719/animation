{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:animation-studio:contracts:v1:fake-provider.request",
  "additionalProperties": false,
  "properties": {
    "prompt": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Prompt",
      "type": "string"
    },
    "seed": {
      "default": 0,
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "timeout_seconds": {
      "default": 10,
      "exclusiveMinimum": 0,
      "maximum": 60,
      "title": "Timeout Seconds",
      "type": "number"
    }
  },
  "required": [
    "prompt"
  ],
  "title": "FakeRequest",
  "type": "object"
}
