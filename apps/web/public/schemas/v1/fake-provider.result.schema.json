{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:animation-studio:contracts:v1:fake-provider.result",
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "image",
            "audio",
            "video"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        }
      },
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "title": "Artifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "provider_name": {
      "const": "fake",
      "default": "fake",
      "title": "Provider Name",
      "type": "string"
    },
    "provider_version": {
      "const": "1",
      "default": "1",
      "title": "Provider Version",
      "type": "string"
    },
    "model_name": {
      "const": "fixture-media",
      "default": "fixture-media",
      "title": "Model Name",
      "type": "string"
    },
    "model_version": {
      "const": "1",
      "default": "1",
      "title": "Model Version",
      "type": "string"
    },
    "seed": {
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "image": {
      "$ref": "#/$defs/Artifact"
    },
    "audio": {
      "$ref": "#/$defs/Artifact"
    },
    "video": {
      "$ref": "#/$defs/Artifact"
    }
  },
  "required": [
    "seed",
    "image",
    "audio",
    "video"
  ],
  "title": "FakeResult",
  "type": "object"
}
