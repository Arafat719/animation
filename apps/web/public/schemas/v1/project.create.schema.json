{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:animation-studio:contracts:v1:project.create",
  "properties": {
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "master_prompt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Master Prompt"
    },
    "target_duration_seconds": {
      "anyOf": [
        {
          "maximum": 600,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Duration Seconds"
    },
    "status": {
      "default": "draft",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "title": "ProjectCreate",
  "type": "object"
}
