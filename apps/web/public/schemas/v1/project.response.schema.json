{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:animation-studio:contracts:v1:project.response",
  "properties": {
    "id": {
      "title": "Id",
      "type": "integer"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "master_prompt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Master Prompt"
    },
    "target_duration_seconds": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Duration Seconds"
    },
    "status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "draft",
      "title": "Status"
    }
  },
  "required": [
    "id",
    "title"
  ],
  "title": "Project",
  "type": "object"
}
